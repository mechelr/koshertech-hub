<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="KosherTech"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KosherTech"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="18sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SETTINGS"
                        android:textColor="@color/muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.22"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Status card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status"
                android:padding="16dp"
                android:layout_marginTop="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="26sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Protected Device"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/deviceModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This device"
                        android:textColor="@color/cyan"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Managed &amp; filtered by KosherTech"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Connectivity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONNECTIVITY"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/tileWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#1E88E5">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📶"
                        android:textSize="20sp"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Wi-Fi" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Connect to a network" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="24sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#22D3EE">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🔷"
                        android:textSize="20sp"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Bluetooth" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pair headphones &amp; devices" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="24sp"/>
            </LinearLayout>

            <!-- Section: Device -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVICE"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/tileDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#9333EA">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🖥️"
                        android:textSize="20sp"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Display" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Brightness &amp; screen timeout" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="24sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#E0A52B">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🔊"
                        android:textSize="20sp"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Sound &amp; Volume" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ringer, media &amp; alarms" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="24sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#34D399">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🔒"
                        android:textSize="20sp"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Security" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Set a screen lock / PIN" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="@color/muted" android:textSize="24sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KosherTech · Secure by design"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/glowBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glow_border"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"/>

</FrameLayout>
