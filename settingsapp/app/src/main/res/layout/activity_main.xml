<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="Settings"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="11dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="22sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KOSHERTECH"
                        android:textColor="@color/muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.22"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Status card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="15dp"
                android:layout_marginTop="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="24sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Protected Device"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                    <TextView
                        android:id="@+id/deviceModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This device"
                        android:textColor="@color/cyan"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CONNECTIVITY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONNECTIVITY"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="9dp"
                android:paddingStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:id="@+id/tileWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#1E88E5">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="📶" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Wi-Fi" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Connect to a network" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileBluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#22D3EE">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="🔷" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Bluetooth" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pair headphones &amp; devices" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#34D399">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="📡" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mobile network" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SIM, data &amp; cellular" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileApn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#E0A52B">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="🌐" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="APN (carrier internet)" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Access point names" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- DEVICE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVICE"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="9dp"
                android:paddingStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <LinearLayout
                    android:id="@+id/tileDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#9333EA">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="🖥️" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Display" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Brightness &amp; screen timeout" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#E0A52B">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="🔊" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Sound &amp; Volume" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ringer, media &amp; alarms" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#34D399">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="🔒" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Security" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Set a screen lock / PIN" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileFlash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#E0A52B">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="🔦" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Flashlight" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Turn the light on or off" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/flashState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Off" android:textColor="@color/muted" android:textStyle="bold" android:textSize="13sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileRotate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#22D3EE">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="🔄" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto-rotate" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Rotate the screen with the phone" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/rotateState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Off" android:textColor="@color/muted" android:textStyle="bold" android:textSize="13sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/line" android:layout_marginStart="64dp"/>

                <LinearLayout
                    android:id="@+id/tileLed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="13dp"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                        android:background="@drawable/bg_chip" android:backgroundTint="#EC4899">
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:gravity="center" android:text="💡" android:textSize="18sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="13dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="LED Light" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Back light brightness &amp; modes" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="1dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/muted" android:textSize="22sp"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KosherTech · Secure by design"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
