<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖥️  Display"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingHorizontal="24dp"/>
        <TextView
            android:id="@+id/closeX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="✕"
            android:textColor="@color/muted"
            android:textSize="18sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <!-- Grant banner (shown only if permission not granted) -->
    <LinearLayout
        android:id="@+id/grantBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_ghost"
        android:padding="14dp"
        android:layout_marginTop="14dp"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow KosherTech to adjust the display"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="One-time permission so the sliders can change brightness and timeout."
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginTop="3dp"/>
        <TextView
            android:id="@+id/grantBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            android:textColor="#04121C"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingHorizontal="22dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_request"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Brightness card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bright"
        android:padding="16dp"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="22sp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brightness"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginStart="10dp"/>
            <TextView
                android:id="@+id/brightnessPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="@color/cyan"
                android:textStyle="bold"
                android:textSize="18sp"/>
        </LinearLayout>
        <SeekBar
            android:id="@+id/brightnessSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="255"
            android:progressTint="@color/cyan"
            android:thumbTint="@color/cyan"/>
    </LinearLayout>

    <!-- Screen timeout card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱  Screen timeout"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"/>
        <LinearLayout
            android:id="@+id/timeoutRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Theme card: dark / light -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◐  Theme"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"/>
        <LinearLayout
            android:id="@+id/themeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</LinearLayout>
