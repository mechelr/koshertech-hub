<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root">

    <!-- Animated ambient glow (pulses softly in MainActivity), behind the content -->
    <View
        android:id="@+id/glowView"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_glow_anim"
        android:importantForAccessibility="no"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="KosherTech logo"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="18sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textColor="@color/muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.14"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Update bar (always visible; shows status, tap to check / update) -->
            <LinearLayout
                android:id="@+id/updateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_update"
                android:padding="13dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/updateIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄"
                    android:textSize="20sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="11dp">
                    <TextView
                        android:id="@+id/updateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking for updates…"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/updateSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version 1.0"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/updateAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update"
                    android:textColor="#04121C"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_request"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Announcements from KosherTech (each dismissible by the customer) -->
            <LinearLayout
                android:id="@+id/announcementList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>

            <!-- Greeting -->
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good evening"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="26sp"
                android:letterSpacing="-0.01"
                android:layout_marginTop="18dp"/>

            <!-- Zmanim + Hebrew date card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_status"
                android:padding="17dp"
                android:layout_marginTop="12dp"
                android:elevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/hebrewDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="17sp"/>
                        <TextView
                            android:id="@+id/englishDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/muted"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/zmanimLoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕯️ Zmanim"
                        android:textColor="@color/cyan"
                        android:textSize="10sp"
                        android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/zmanimGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search"
                    android:padding="10dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🕯️  Candle Lighting (Fri)"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/candleVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/gold"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Weather (display only — never clickable, goes nowhere) -->
            <LinearLayout
                android:id="@+id/weatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_status"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:clickable="false"
                android:focusable="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/weatherNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="34sp"/>
                        <TextView
                            android:id="@+id/weatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weather"
                            android:textColor="@color/muted"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/weatherIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌤️"
                        android:textSize="40sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weatherDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"/>
            </LinearLayout>

            <!-- Quick toggles (flashlight, auto-rotate) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:id="@+id/toggleFlash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🔦  Flashlight"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true"/>
                <TextView
                    android:id="@+id/toggleRotate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🔄  Auto-rotate"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_card"
                    android:layout_marginStart="5dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Search -->
            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search"
                android:hint="Search apps"
                android:textColorHint="@color/muted"
                android:textColor="@color/white"
                android:padding="12dp"
                android:inputType="text"
                android:maxLines="1"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Apps"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Need another app?"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tell us which app and why. We will review it."
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:id="@+id/requestButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+  Request an App"
                    android:gravity="center"
                    android:textColor="#04121C"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_request"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Live status of the customer's app requests (filled from the backend) -->
                <TextView
                    android:id="@+id/requestStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your requests"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"/>
                <LinearLayout
                    android:id="@+id/requestStatusList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Tools -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tools"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:id="@+id/tileCalendar" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hebrew Calendar" android:textColor="@color/white" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp"/>
                </LinearLayout>
                <View android:layout_width="9dp" android:layout_height="1dp"/>
                <LinearLayout android:id="@+id/tileParental" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔒" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Parental Controls" android:textColor="@color/white" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="9dp">
                <LinearLayout android:id="@+id/tileAutomations" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automations" android:textColor="@color/white" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp"/>
                </LinearLayout>
                <View android:layout_width="9dp" android:layout_height="1dp"/>
                <LinearLayout android:id="@+id/tileHelp" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❓" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Help &amp; Support" android:textColor="@color/white" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="9dp">
                <LinearLayout android:id="@+id/tileMirror" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪞" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mirror" android:textColor="@color/white" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp"/>
                </LinearLayout>
                <View android:layout_width="9dp" android:layout_height="1dp"/>
                <LinearLayout android:id="@+id/tileAppLock" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_card" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔐" android:textSize="24sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App Lock" android:textColor="@color/white" android:textStyle="bold" android:textSize="12sp" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">
                <TextView
                    android:id="@+id/loopholeButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛡  Report a Loophole"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingVertical="11dp"
                    android:background="@drawable/bg_secondary"
                    android:clickable="true"
                    android:focusable="true"/>
                <View
                    android:layout_width="9dp"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/rateButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐  Rate Us"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingVertical="11dp"
                    android:background="@drawable/bg_secondary"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <TextView
                    android:id="@+id/buyPlanButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛒  Buy Plan"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingVertical="11dp"
                    android:background="@drawable/bg_secondary"
                    android:clickable="true"
                    android:focusable="true"/>
                <View
                    android:layout_width="9dp"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/updatePaymentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💳  Update Payment"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingVertical="11dp"
                    android:background="@drawable/bg_secondary"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KosherTech · Approved apps only"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:gravity="center"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Floating live-chat button -->
    <TextView
        android:id="@+id/chatFab"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:text="💬"
        android:textSize="24sp"
        android:gravity="center"
        android:background="@drawable/bg_chatfab"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Gemini-style multi-color glow framing the whole screen (never eats touches) -->
    <com.koshertech.hub.GlowBorderView
        android:id="@+id/glowBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="12dp"
        android:importantForAccessibility="no"/>

</FrameLayout>
