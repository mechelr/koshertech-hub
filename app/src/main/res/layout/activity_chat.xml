<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_root">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:fontFamily="@font/inter_black" android:letterSpacing="-0.02" android:id="@+id/backBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹" android:textColor="@color/white" android:textSize="26sp" android:paddingEnd="12dp" android:clickable="true" android:focusable="true"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:fontFamily="@font/inter_extrabold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💬  Live Chat" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="KosherTech Support · usually replies fast" android:textColor="@color/muted" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line"/>

    <ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:padding="14dp">
        <LinearLayout android:id="@+id/chatMessages" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@color/card">
        <EditText android:id="@+id/chatInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="Type a message…" android:textColorHint="@color/muted" android:textColor="@color/white"
            android:background="@drawable/bg_search" android:padding="12dp" android:maxLines="4" android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no"/>
        <TextView android:id="@+id/chatSend" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Send" android:textColor="#1E1B4B" android:textStyle="bold" android:textSize="14sp"
            android:paddingHorizontal="18dp" android:paddingVertical="12dp" android:background="@drawable/bg_request"
            android:layout_marginStart="9dp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</LinearLayout>
