<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request an App"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingHorizontal="24dp"/>
        <TextView
            android:id="@+id/closeX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="✕"
            android:textColor="@color/muted"
            android:textSize="18sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tell us which app and why. We'll review it."
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/reqAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="App name"
        android:textColorHint="@color/muted"
        android:textColor="@color/white"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:inputType="text"
        android:importantForAutofill="no"/>

    <EditText
        android:id="@+id/reqReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Reason"
        android:textColorHint="@color/muted"
        android:textColor="@color/white"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:minLines="2"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:importantForAutofill="no"/>

    <TextView
        android:id="@+id/primaryBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send request"
        android:gravity="center"
        android:textColor="#04121C"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingVertical="14dp"
        android:background="@drawable/bg_request"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"/>
</LinearLayout>
