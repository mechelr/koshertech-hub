<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_root" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <TextView android:fontFamily="@font/inter_black" android:letterSpacing="-0.02" android:id="@+id/backBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="‹" android:textColor="@color/white" android:textSize="26sp" android:paddingEnd="12dp"
                android:clickable="true" android:focusable="true"/>
            <TextView android:fontFamily="@font/inter_extrabold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📅  Hebrew Calendar" android:textColor="@color/white" android:textStyle="bold" android:textSize="19sp"/>
        </LinearLayout>

        <TextView android:fontFamily="@font/inter_extrabold" android:id="@+id/calMonth" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp"
            android:gravity="center" android:layout_marginTop="18dp"/>
        <TextView android:id="@+id/calMonthEn" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="—" android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:layout_marginTop="2dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:gravity="center" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="M" android:gravity="center" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:gravity="center" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W" android:gravity="center" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="T" android:gravity="center" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F" android:gravity="center" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S" android:gravity="center" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/calGrid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:fontFamily="@font/inter_extrabold" android:id="@+id/calParsha" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Parshas HaShavua"
                    android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Candle Lighting"
                    android:textColor="@color/muted" android:textSize="11sp"/>
                <TextView android:fontFamily="@font/inter_extrabold" android:id="@+id/calCandle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KosherTech · Hebrew Calendar"
            android:textColor="@color/muted" android:textSize="10sp" android:gravity="center" android:layout_marginTop="18dp"/>
    </LinearLayout>
</ScrollView>
