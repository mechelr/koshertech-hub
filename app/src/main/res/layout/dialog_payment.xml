<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:fontFamily="@font/inter_extrabold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💳  Payment"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingHorizontal="24dp"/>
        <TextView
            android:id="@+id/closeX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="✕"
            android:textColor="@color/muted"
            android:textSize="18sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <TextView
        android:id="@+id/payTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your card details"
        android:textColor="@color/cyan"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/cardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Name on card"
        android:textColorHint="@color/muted"
        android:textColor="@color/white"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:inputType="textPersonName"
        android:importantForAutofill="no"/>

    <EditText
        android:id="@+id/cardNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Card number"
        android:textColorHint="@color/muted"
        android:textColor="@color/white"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:layout_marginBottom="10dp"
        android:inputType="number"
        android:maxLength="19"
        android:importantForAutofill="no"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/cardExpiry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="MM / YY"
            android:textColorHint="@color/muted"
            android:textColor="@color/white"
            android:background="@drawable/bg_search"
            android:padding="12dp"
            android:inputType="text"
            android:importantForAutofill="no"/>
        <View
            android:layout_width="10dp"
            android:layout_height="1dp"/>
        <EditText
            android:id="@+id/cardCvc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="CVC"
            android:textColorHint="@color/muted"
            android:textColor="@color/white"
            android:background="@drawable/bg_search"
            android:padding="12dp"
            android:inputType="number"
            android:maxLength="4"
            android:importantForAutofill="no"/>
    </LinearLayout>

    <TextView android:fontFamily="@font/inter_extrabold"
        android:id="@+id/primaryBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit payment"
        android:gravity="center"
        android:textColor="#1E1B4B"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingVertical="14dp"
        android:background="@drawable/bg_request"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"/>
</LinearLayout>
