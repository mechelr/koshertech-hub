<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐  Rate KosherTech"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingHorizontal="24dp"/>
        <TextView
            android:id="@+id/closeX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="✕"
            android:textColor="@color/muted"
            android:textSize="18sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1"
        android:rating="5"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/rateComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Anything to add? (optional)"
        android:textColorHint="@color/muted"
        android:textColor="@color/white"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:inputType="textMultiLine"
        android:importantForAutofill="no"/>

    <TextView
        android:id="@+id/primaryBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send rating"
        android:gravity="center"
        android:textColor="#04121C"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingVertical="14dp"
        android:background="@drawable/bg_request"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"/>
</LinearLayout>
