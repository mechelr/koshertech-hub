<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer cyan glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="6dp" android:color="#5522D3EE"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <!-- crisp cyan edge -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#CC22D3EE"/>
            <corners android:radius="23dp"/>
        </shape>
    </item>
    <!-- inner violet accent -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#886F5BD0"/>
            <corners android:radius="21dp"/>
        </shape>
    </item>
</layer-list>
