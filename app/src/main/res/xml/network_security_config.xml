<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust the device's built-in CAs AND any certificate the content
         filter installs (user store). This lets the app work on filtered
         devices that inspect HTTPS traffic (TechLoq, etc.). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
